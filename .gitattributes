# Set the default behavior, in case persons do not have core.autocrlf set.
* text=auto eol=lf

# Explicitly declare text files that need always to be normalised
# and converted to native line endings on checkout.
*.bib text eol=lf diff=bibtex
*.code-workspace text eol=lf
*.json text eol=lf
*.md text eol=lf diff=markdown
*.tex text eol=lf diff=tex
*.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENCE text eol=lf
Markfile text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.jpg binary
*.pdf binary
*.png binary
